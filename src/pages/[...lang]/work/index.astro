---
import { languages, defaultLang, showDefaultLang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';
import Layout from "../../../layouts/Layout.astro";
import SectionHeader from "../../../components/SectionHeader.astro";
import ModeSwitch from "../../../components/ModeSwitch.astro";
import MotionGallery from "../../../features/motions/components/MotionGallery.astro";
import ArtworkGallery from "../../../features/artwork/components/ArtworkGallery.astro";
import { fetchVideos, fetchArtworks } from "../../../lib/hygraph";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang && !showDefaultLang ? undefined : lang }
  }));
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof languages);

const [videos, artworks] = await Promise.all([
  fetchVideos(),
  fetchArtworks(),
]);

const makePage = <T,>(data: T[]) => ({
  data,
  currentPage: 1,
  lastPage: 1,
  size: data.length,
  total: data.length,
  start: 0,
  end: Math.max(0, data.length - 1),
  url: { current: "/work/", prev: undefined, next: undefined, first: undefined, last: undefined },
});

const videoPage = makePage(videos);
const artworkPage = makePage(artworks);
---

<Layout title={`Kimeyu Work - ${t('works.title')}`}>
  <Fragment slot="banner">
    <div class="works-hero-group">
      <SectionHeader
        title={t('works.title')}
        isBanner={true}
        isHeroBanner={true}
        align="responsive"
      />
      <div class="switch-overlap">
        <ModeSwitch activeMode="motions" />
      </div>
    </div>
  </Fragment>

  <div class="spa-gallery-wrapper" id="spa-wrapper">
    <div class="spa-panel" id="panel-motions">
      <MotionGallery page={videoPage} />
    </div>
    <div class="spa-panel is-hidden" id="panel-artwork">
      <ArtworkGallery page={artworkPage} />
    </div>
  </div>
</Layout>

<style is:global>
  @import "../../../styles/works-hero.css";

  :root {
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ease-exit: cubic-bezier(0.87, 0.05, 0.02, 0.97);
  }

  .is-hidden {
    display: none !important;
  }

  @keyframes springEnter {
    0% {
      transform: translate3d(0, 40px, 0) scaleY(0.8);
      opacity: 0;
    }
    100% {
      transform: translate3d(0, 0, 0) scaleY(1);
      opacity: 1;
    }
  }

  @keyframes springExit {
    0% {
      transform: translate3d(0, 0, 0) scaleY(1);
      opacity: 1;
    }
    100% {
      transform: translate3d(0, 20px, 0) scaleY(0);
      opacity: 0;
    }
  }

  .card-item {
    animation: springEnter 0.55s var(--ease-spring) both;
    animation-delay: calc(var(--i, 0) * 0.035s);
    transform-origin: center bottom;
    will-change: transform, opacity;
  }

  .is-exiting .card-item {
    animation: springExit 0.2s var(--ease-exit) forwards !important;
    animation-delay: 0s !important;
  }

  .section-header__title-text,
  .section-header__subtitle {
    will-change: transform, opacity;
  }
</style>

<script>
  const PANEL_MOTIONS_ID = "panel-motions";
  const PANEL_ARTWORK_ID = "panel-artwork";

  let currentMode = "motions";
  let animating = false;

  function applyPanelState(mode: string) {
    const motions = document.getElementById(PANEL_MOTIONS_ID);
    const artwork = document.getElementById(PANEL_ARTWORK_ID);
    if (!motions || !artwork) return;

    if (mode === "artwork") {
      motions.classList.add("is-hidden");
      artwork.classList.remove("is-hidden");
    } else {
      artwork.classList.add("is-hidden");
      motions.classList.remove("is-hidden");
    }
  }

  function updatePillUI(target: string) {
    const container = document.querySelector<HTMLElement>(".mode-switch-container");
    if (!container) return;
    container.dataset.activeMode = target;
    container.querySelectorAll<HTMLElement>(".switch-btn").forEach((b) => {
      const active = b.dataset.mode === target;
      b.classList.toggle("is-active", active);
      b.setAttribute("aria-pressed", active ? "true" : "false");
    });
  }

  function animateHeaderExit(panel: HTMLElement) {
    const title = panel.querySelector<HTMLElement>(".section-header__title-text") || panel.querySelector<HTMLElement>(".section-header__title");
    const subtitle = panel.querySelector<HTMLElement>(".section-header__subtitle");
    if (title) {
      title.style.transition = "transform 0.2s var(--ease-exit), opacity 0.2s var(--ease-exit)";
      title.style.transform = "translate3d(0, -12px, 0)";
      title.style.opacity = "0";
    }
    if (subtitle) {
      subtitle.style.transition = "transform 0.2s var(--ease-exit), opacity 0.2s var(--ease-exit)";
      subtitle.style.transform = "translate3d(0, 8px, 0)";
      subtitle.style.opacity = "0";
    }
  }

  function animateHeaderEnter(panel: HTMLElement) {
    const title = panel.querySelector<HTMLElement>(".section-header__title-text") || panel.querySelector<HTMLElement>(".section-header__title");
    const subtitle = panel.querySelector<HTMLElement>(".section-header__subtitle");
    if (title) {
      title.style.transition = "none";
      title.style.transform = "translate3d(0, -12px, 0)";
      title.style.opacity = "0";
    }
    if (subtitle) {
      subtitle.style.transition = "none";
      subtitle.style.transform = "translate3d(0, 8px, 0)";
      subtitle.style.opacity = "0";
    }

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (title) {
          title.style.transition = "transform 0.55s var(--ease-spring), opacity 0.55s var(--ease-spring)";
          title.style.transform = "translate3d(0, 0, 0)";
          title.style.opacity = "1";
        }
        if (subtitle) {
          subtitle.style.transition = "transform 0.55s var(--ease-spring) 0.05s, opacity 0.55s var(--ease-spring) 0.05s";
          subtitle.style.transform = "translate3d(0, 0, 0)";
          subtitle.style.opacity = "1";
        }
      });
    });
  }

  function switchTo(target: string) {
    if (target === currentMode || animating) return;
    animating = true;

    updatePillUI(target);

    const currentPanel = document.querySelector<HTMLElement>(".spa-panel:not(.is-hidden)");
    const currentGrid = currentPanel?.querySelector<HTMLElement>(".motions-grid, .artwork-masonry, [id$='-grid-container']");

    if (currentGrid) {
      currentGrid.classList.add("is-exiting");
    }
    if (currentPanel) {
      animateHeaderExit(currentPanel);
    }

    setTimeout(() => {
      if (currentGrid) {
        currentGrid.classList.remove("is-exiting");
      }
      applyPanelState(target);
      currentMode = target;

      const nextPanel = document.querySelector<HTMLElement>(".spa-panel:not(.is-hidden)");
      const nextGrid = nextPanel?.querySelector<HTMLElement>(".motions-grid, .artwork-masonry, [id$='-grid-container']");
      if (nextGrid) {
        nextGrid.classList.remove("is-exiting");
      }
      if (nextPanel) {
        animateHeaderEnter(nextPanel);
      }

      const basePath = window.location.pathname.replace(/\/$/, "");
      history.pushState(
        { mode: target },
        "",
        target === "motions" ? basePath || "/" : (basePath || "") + "?mode=artwork"
      );

      setTimeout(() => {
        const activeTitle = nextPanel?.querySelector<HTMLElement>(".section-header__title-text") || nextPanel?.querySelector<HTMLElement>(".section-header__title");
        const activeSubtitle = nextPanel?.querySelector<HTMLElement>(".section-header__subtitle");
        if (activeTitle) {
          activeTitle.style.transition = "";
          activeTitle.style.transform = "";
          activeTitle.style.opacity = "";
        }
        if (activeSubtitle) {
          activeSubtitle.style.transition = "";
          activeSubtitle.style.transform = "";
          activeSubtitle.style.opacity = "";
        }
        animating = false;
      }, 650);
    }, 200);
  }

  function bindSwitch() {
    const container = document.querySelector<HTMLElement>(".mode-switch-container");
    if (!container || (container as any)._hasBoundSwitch) return;
    (container as any)._hasBoundSwitch = true;

    container.addEventListener("click", (e: Event) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-mode]");
      if (!btn || !container.contains(btn)) return;
      const mode = btn.dataset.mode;
      if (mode === "toggle") {
        switchTo(currentMode === "motions" ? "artwork" : "motions");
      } else if (mode === "motions" || mode === "artwork") {
        switchTo(mode);
      }
    });
  }

  function init() {
    animating = false;
    currentMode = "motions";

    applyPanelState("motions");
    updatePillUI("motions");
    bindSwitch();

    if (new URLSearchParams(location.search).get("mode") === "artwork") {
      applyPanelState("artwork");
      updatePillUI("artwork");
      currentMode = "artwork";
    }
  }

  init();
  document.addEventListener("astro:page-load", init);

  window.addEventListener("popstate", (e) => {
    const mode = (e.state && e.state.mode) || (new URLSearchParams(location.search).get("mode") === "artwork" ? "artwork" : "motions");
    if (mode !== currentMode) {
      switchTo(mode);
    }
  });
</script>
