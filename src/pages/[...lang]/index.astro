---
import Layout from "../../layouts/Layout.astro";
import KimeSplash from "../../components/KimeSplash.astro";
import { languages, defaultLang, showDefaultLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { fetchVideos, fetchSiteProfile } from "../../lib/hygraph";
import '../../styles/home.css';

import HeroSection from '../../components/HeroSection.astro';
import FeaturedWorks from '../../components/FeaturedWorks.astro';
import OtherWorks from '../../components/OtherWorks.astro';
import ContactSection from '../../components/ContactSection.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang && !showDefaultLang ? undefined : lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang || defaultLang) as keyof typeof languages;
const t = useTranslations(currentLang);

const [allVideos, profileData] = await Promise.all([
  fetchVideos(),
  fetchSiteProfile().catch(() => null),
]);

const discordLink = profileData?.linkDiscord || "https://discord.com/users/683574461147906078";
const discordHandle = profileData?.handleDiscord || "kimeyu_39";

const xLink = profileData?.linkX || "https://twitter.com/Kimeru2001";
const xHandle = profileData?.handleX || "@Kimeru2001";

const fbLink = profileData?.linkFacebook || "https://facebook.com/kimerukirisu/";
const fbHandle = profileData?.handleFacebook || "facebook.com/kimerukirisu/";

const emailLink = profileData?.linkEmail || "mailto:kimeyukawa@gmail.com";
const emailHandle = profileData?.handleEmail || "kimeyukawa@gmail.com";

const featuredVideos = allVideos.filter((v) => v.isFeatured).slice(0, 6);
---

<Layout title="kimeyu.work">
  <div class="contact-page-wrapper">
    <KimeSplash />

    <div class="decor-ribbon" aria-hidden="true">
      <div class="film-strip-bg" aria-hidden="true">
        <div class="banner-strip"></div>
      </div>
    </div>

    <HeroSection t={t} />
    <FeaturedWorks featuredVideos={featuredVideos} currentLang={currentLang} />
    <OtherWorks currentLang={currentLang} />
    <ContactSection
      t={t}
      currentLang={currentLang}
      discordLink={discordLink}
      discordHandle={discordHandle}
      xLink={xLink}
      xHandle={xHandle}
      fbLink={fbLink}
      fbHandle={fbHandle}
      emailLink={emailLink}
      emailHandle={emailHandle}
    />
  </div>
</Layout>