---
import FsTagMotion from "./icons/FsTagMotion.astro";
import FsPlayLinkPink from "./icons/FsPlayLinkPink.astro";
import FsPlayLinkWhite from "./icons/FsPlayLinkWhite.astro";
import { getRelativeLocaleUrl } from '../i18n/utils';

const { featuredVideos, currentLang } = Astro.props;
---

<section class="featured-works-section" aria-label="Featured Works" id="featured-works-section">
  <div class="fs-viewport">
    <div class="fs-inner" id="fs-inner">
      {
        featuredVideos.slice(0, 3).map((video: any, index: number) => (
          <article class="featured-sticky-card">
            <div class="fs-card-inner">
              <div class="fs-bg-watermark" aria-hidden="true">FEATURED</div>
              <div class="fs-video-area">
                <a href={getRelativeLocaleUrl(currentLang, `work/motions/${video.slug}`)} class="fs-thumb-link" aria-label={`Watch ${video.title}`}>
                  <div class="fs-thumb-frame">
                    <img src={video.thumbnail.url} alt={video.title} loading="lazy" decoding="async" width="640" height="360" class="fs-thumb-img" />
                  </div>
                </a>
              </div>
              <div class="fs-bottom-left">
                <div class="fs-tags" style="margin-bottom: 20px;">
                    <FsTagMotion type={index === 1 ? "pink" : "white"} />
                  <div class="label">
                    {video.category?.visibility === "Private" ? "Private" : "Public"}
                  </div>
                </div>
                <div class="fs-number"><span class="mask-text">0{index + 1}</span></div>
                <div class="fs-title-play-row">
                  <div class="fs-titles">
                    <h4 class="fs-artist"><span class="mask-text">{video.nameArtist}</span></h4>
                    <h3 class="fs-title"><span class="mask-text decode-target" data-decode-text={video.title}>{video.title}</span></h3>
                  </div>
                  <div class="fs-play-link-group">
                    {index === 1 ? <FsPlayLinkPink /> : <FsPlayLinkWhite />}
                    <a href={getRelativeLocaleUrl(currentLang, `work/motions/${video.slug}`)} class="fs-play-overlay fs-play-overlay--play" aria-label={`Watch ${video.title}`}></a>
                    <a href={getRelativeLocaleUrl(currentLang, "work/")} class="fs-play-overlay fs-play-overlay--more" aria-label="View More Works"></a>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="fs-pop-mobile" aria-label="Featured Works">
  <div class="fs-pop-list">
    {featuredVideos.slice(0, 3).map((video: any, index: number) => (
      <a href={getRelativeLocaleUrl(currentLang, `work/motions/${video.slug}`)} class={`fs-pop-card ${index === 1 ? 'fs-pop-card-alt' : ''}`} aria-label={`Watch ${video.title}`}>
        <div class="fs-pop-watermark" aria-hidden="true">0{index + 1}</div>
        <div class="fs-pop-thumb-box">
          <div class="fs-pop-thumb-bg"></div>
          <img src={video.thumbnail.url} alt={video.title} loading="lazy" decoding="async" width="640" height="360" class="fs-pop-thumb" />
          <div class="fs-pop-thumb-cut"></div>
        </div>
        <div class="fs-pop-info">
          <div class="fs-pop-meta">
            <span class="fs-pop-tag">{video.category?.name?.toUpperCase() || "MOTION"}</span>
          </div>
          <h3 class="fs-pop-title">{video.title}</h3>
          <p class="fs-pop-artist">{video.nameArtist}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  const initFeaturedSnap = () => {
    const section = document.getElementById('featured-works-section');
    const inner = document.getElementById('fs-inner');
    if (!section || !inner) return;

    if (window.innerWidth <= 1024) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
          }
        });
      }, { threshold: 0.2 });
      Array.from(inner.children).forEach(child => observer.observe(child));
      return;
    }

    const updateMarquees = () => {
      const titles = section.querySelectorAll<HTMLElement>('.fs-title');
      titles.forEach((title) => {
        const text = title.querySelector<HTMLElement>('.mask-text');
        if (!text) return;
        title.classList.remove('is-marquee');
        const overflow = text.scrollWidth - title.clientWidth;
        if (overflow > 10) {
          const dur = Math.max(12, Math.round(text.scrollWidth / 45));
          title.style.setProperty('--marquee-duration', `${dur}s`);
          title.classList.add('is-marquee');
        } else {
          title.classList.remove('is-marquee');
        }
      });
    };
    updateMarquees();

    const SLIDE_COUNT = inner.children.length;
    const ANIM_DURATION = 700;
    let currentSlide = 0;

    const goTo = (index: number) => {
      const prev = currentSlide;
      currentSlide = Math.max(0, Math.min(SLIDE_COUNT - 1, index));
      if (prev === currentSlide) return;
      inner.style.transform = `translateY(${-currentSlide * 100}%)`;

      const prevChild = inner.children[prev];
      const nextChild = inner.children[currentSlide];
      if (prevChild) setTimeout(() => prevChild.classList.remove('is-active'), ANIM_DURATION);
      if (nextChild) setTimeout(() => nextChild.classList.add('is-active'), 400);
    };

    const initialObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && currentSlide === 0) {
          if (inner.children[0]) {
            inner.children[0].classList.add('is-active');
          }
          initialObserver.disconnect();
        }
      });
    }, { threshold: 0.3 });
    initialObserver.observe(section);

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const r = section.getBoundingClientRect();
        const maxScroll = r.height - window.innerHeight;
        if (maxScroll > 0) {
          const progress = Math.max(0, Math.min(1, -r.top / maxScroll));
          const targetSlide = Math.min(SLIDE_COUNT - 1, Math.floor(progress * SLIDE_COUNT));
          if (targetSlide !== currentSlide) {
            goTo(targetSlide);
          }
        }
        ticking = false;
      });
    };

    const resetObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting && entry.boundingClientRect.top > 0 && currentSlide !== 0) {
          if (inner.children[currentSlide]) {
            inner.children[currentSlide].classList.remove('is-active');
          }
          currentSlide = 0;
          inner.style.transform = 'translateY(0)';
          if (inner.children[0]) {
            inner.children[0].classList.add('is-active');
          }
        }
      }
    }, { threshold: 0 });
    resetObserver.observe(section);

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', updateMarquees, { passive: true });
    onScroll();

    const cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', updateMarquees);
      initialObserver.disconnect();
      resetObserver.disconnect();
      document.removeEventListener('astro:before-swap', cleanup);
    };
    document.addEventListener('astro:before-swap', cleanup);
  };

  document.addEventListener('astro:page-load', initFeaturedSnap);
</script>
