---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SvgDefs from "../components/SvgDefs.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const SITE_URL = "https://kimeyu.vercel.app";
const DEFAULT_DESC =
  "Beyond shapes, a hidden frequency. Every frame, a destination. Every rhythm, a heartbeat. Flawless harmony between graphics and sound. Catch it if you can. — Hi! I'm KIMEYU!";

const {
  title,
  description = DEFAULT_DESC,
  ogImage = `${SITE_URL}/og-image.png`,
} = Astro.props;

const canonicalURL = `${SITE_URL}${Astro.url.pathname}`;
const isHome = Astro.url.pathname === "/" || /^\/(?:en|ja|vi)\/?$/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content="#FA729D" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Murecho:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Kimeyu Work" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" property="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" property="twitter:title" content={title} />
    <meta
      name="twitter:description"
      property="twitter:description"
      content={description}
    />
    <meta name="twitter:image" property="twitter:image" content={ogImage} />

    <ClientRouter fallback="swap" />

    <script is:inline>
      if (sessionStorage.getItem("kime-splash-played")) {
        document.documentElement.classList.add("splash-done");
      }
    </script>

    <slot name="head" />
  </head>
  <body>
    {isHome && (
      <div id="splash-screen" aria-hidden="true">
        <div id="splash-lottie"></div>
      </div>
    )}

    <div
      id="kime-nav-overlay"
      transition:persist="nav-overlay"
      aria-hidden="true"
    >
      <div class="kime-row" style="--d: 0.24s">
        <div></div><div></div><div></div>
      </div>
      <div class="kime-row" style="--d: 0s">
        <div></div><div></div><div></div>
      </div>
      <div class="kime-row" style="--d: 0.48s">
        <div></div><div></div><div></div>
      </div>
      <div class="kime-row" style="--d: 0.12s">
        <div></div><div></div><div></div>
      </div>
      <div class="kime-row" style="--d: 0.36s">
        <div></div><div></div><div></div>
      </div>
    </div>

    <SvgDefs />
    <Header />
    <main>
      <slot name="banner" />
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  #splash-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f2f2f9;
  }

  #splash-screen.gone,
  html.splash-done #splash-screen {
    display: none !important;
  }

  #splash-lottie {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    transform: translate3d(0, 0, 0);
    text-align: center;
  }

  #kime-nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 99998;
    pointer-events: none;
    overflow: hidden;
  }

  .kime-row {
    position: absolute;
    left: 0;
    width: 100%;
    height: 21%;
  }

  .kime-row:nth-child(1) { top: 0; }
  .kime-row:nth-child(2) { top: 20%; }
  .kime-row:nth-child(3) { top: 40%; }
  .kime-row:nth-child(4) { top: 60%; }
  .kime-row:nth-child(5) { top: 80%; }

  .kime-row div {
    position: absolute;
    inset: 0;
    transform: translateX(101%);
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .kime-row div:nth-child(1) {
    background-color: #66e8ff;
    z-index: 1;
  }
  .kime-row div:nth-child(2) {
    background-color: #fa729d;
    z-index: 2;
  }
  .kime-row div:nth-child(3) {
    background-color: #f2f2f9;
    z-index: 3;
  }

  #kime-nav-overlay.is-active,
  #kime-nav-overlay.is-covered,
  #kime-nav-overlay.is-revealing {
    pointer-events: auto;
  }

  #kime-nav-overlay.is-covered .kime-row div {
    transform: translateX(0%);
    animation: none;
  }

  #kime-nav-overlay.is-revealing .kime-row div {
    animation: kime-reveal 0.8s cubic-bezier(0.94, 0.01, 0.12, 0.98) both;
  }
  #kime-nav-overlay.is-revealing .kime-row div:nth-child(3) {
    animation-delay: calc(0s + var(--d));
  }
  #kime-nav-overlay.is-revealing .kime-row div:nth-child(2) {
    animation-delay: calc(0.15s + var(--d));
  }
  #kime-nav-overlay.is-revealing .kime-row div:nth-child(1) {
    animation-delay: calc(0.3s + var(--d));
  }

  @keyframes kime-reveal {
    from {
      transform: translateX(0%);
    }
    to {
      transform: translateX(101%);
    }
  }


</style>

<script>
  const SPLASH_KEY: string = "kime-splash-played";
  let isSplashRunning: boolean = false;
  let activeLottie: any = null;
  let isModeSwitchNav: boolean = false;
  let revealTimer: ReturnType<typeof setTimeout> | null = null;
  let activeEndListener: ((e: AnimationEvent) => void) | null = null;

  const killSplash = (): void => {
    isSplashRunning = false;
    if (activeLottie) {
      try {
        activeLottie.destroy();
      } catch {}
      activeLottie = null;
    }
    const splash = document.getElementById("splash-screen");
    splash?.classList.add("gone");
    splash?.remove();
    document.documentElement.classList.add("splash-done");
  };

  const playReveal = (): void => {
    const overlay = document.getElementById("kime-nav-overlay");
    if (!overlay) return;

    if (revealTimer) {
      clearTimeout(revealTimer);
      revealTimer = null;
    }
    if (activeEndListener) {
      overlay.removeEventListener("animationend", activeEndListener);
      activeEndListener = null;
    }

    overlay.classList.remove("is-covered");
    void overlay.offsetHeight;
    overlay.classList.add("is-revealing");

    let done = false;
    const cleanup = () => {
      if (done) return;
      done = true;
      if (revealTimer) {
        clearTimeout(revealTimer);
        revealTimer = null;
      }
      if (activeEndListener) {
        overlay.removeEventListener("animationend", activeEndListener);
        activeEndListener = null;
      }
      overlay.classList.remove("is-active", "is-revealing", "is-covered");
      if (!isSplashRunning) {
        document.documentElement.style.overflow = "";
      }
    };

    activeEndListener = (e: AnimationEvent) => {
      const row3Child1 = overlay.querySelector(".kime-row:nth-child(3) div:nth-child(1)");
      if (e.target === row3Child1) {
        cleanup();
      }
    };
    overlay.addEventListener("animationend", activeEndListener);
    revealTimer = setTimeout(cleanup, 1700);
  };

  const initSplash = async (): Promise<void> => {
    const isHome = location.pathname === "/" || /^\/(?:en|ja|vi)\/?$/.test(location.pathname);
    if (!isHome || sessionStorage.getItem(SPLASH_KEY) || isSplashRunning) {
      killSplash();
      return;
    }

    const splash = document.getElementById("splash-screen");
    const lottieContainer = document.getElementById("splash-lottie");
    if (!splash || !lottieContainer) {
      killSplash();
      return;
    }

    isSplashRunning = true;
    splash.classList.remove("gone");
    document.documentElement.style.overflow = "hidden";

    const overlay = document.getElementById("kime-nav-overlay");
    overlay?.classList.add("is-covered");

    try {
      const lottieModule = await import("lottie-web/build/player/lottie_svg");
      const lottie = lottieModule.default || lottieModule;
      lottie.destroy();

      if (!isSplashRunning) return;

      activeLottie = lottie.loadAnimation({
        container: lottieContainer,
        renderer: "svg",
        loop: false,
        autoplay: true,
        path: "/lottie/webloading.json",
      });

      activeLottie.addEventListener("complete", () => {
        if (!isSplashRunning) return;
        sessionStorage.setItem(SPLASH_KEY, "1");
        killSplash();
        playReveal();
      });
    } catch (err) {
      killSplash();
      overlay?.classList.remove("is-covered");
      document.documentElement.style.overflow = "";
      console.error("[Splash]", err);
    }
  };

  document.addEventListener("astro:before-preparation", (e: any) => {
    if (isSplashRunning) killSplash();

    const fromPath = e.from?.pathname ?? "";
    const toPath = e.to?.pathname ?? "";

    const normalizeRoute = (p: string) => {
      const stripped = p.replace(/^\/(?:en|ja|vi)(?=\/|$)/, "") || "/";
      return stripped.length > 1 && stripped.endsWith("/") ? stripped.slice(0, -1) : stripped;
    };

    const fromRoute = normalizeRoute(fromPath);
    const toRoute = normalizeRoute(toPath);

    if (fromRoute === toRoute && e.from?.search === e.to?.search) {
      isModeSwitchNav = true;
      return;
    }

    isModeSwitchNav =
      (fromRoute.startsWith("/work") && toRoute.startsWith("/work"));

    if (isModeSwitchNav) return;

    const overlay = document.getElementById("kime-nav-overlay");
    overlay?.classList.add("is-active");
  });

  document.addEventListener("astro:before-swap", (e: any) => {
    e.newDocument.getElementById("splash-screen")?.remove();
    e.newDocument.documentElement.classList.add("splash-done");

    if (isModeSwitchNav) {
      const overlay = document.getElementById("kime-nav-overlay");
      overlay?.classList.remove("is-active");
      return;
    }

    if (revealTimer) {
      clearTimeout(revealTimer);
      revealTimer = null;
    }

    const overlay = document.getElementById("kime-nav-overlay");
    if (overlay) {
      if (activeEndListener) {
        overlay.removeEventListener("animationend", activeEndListener);
        activeEndListener = null;
      }
      overlay.classList.remove("is-revealing");
      void overlay.offsetHeight;
      overlay.classList.add("is-covered");
    }
  });

  document.addEventListener("astro:after-swap", () => {
    if (isModeSwitchNav) return;
    playReveal();
  });

  document.addEventListener("astro:page-load", () => {
    if (isModeSwitchNav) {
      isModeSwitchNav = false;
      document.documentElement.style.overflow = "";
      document.getElementById("splash-screen")?.remove();
      const overlay = document.getElementById("kime-nav-overlay");
      overlay?.classList.remove("is-active");
      return;
    }
    initSplash();
  });
</script>
